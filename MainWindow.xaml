<Window x:Class="prakt6_koscheev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakt6_koscheev"
        mc:Ignorable="d"
        Background="{DynamicResource theme}"
        Title="MainWindow" Height="800" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel}" Width="461">
                <Button Style="{StaticResource UpdateButton}" Width="106">припарковаться</Button>
                <Button Style="{StaticResource DeleteButton}" Width="148">выпрыгнуть из машины</Button>
                <Button Style="{StaticResource ThemeSwitch}" Click="ChangeThemeButton_Click">тема</Button>
            </WrapPanel>
            <WrapPanel>
                <WrapPanel Style="{StaticResource FirstWrapPanel3}" VerticalAlignment="Center" Width="397" HorizontalAlignment="Center" Height="266">
                    <TextBlock>вы готовы?</TextBlock>
                    <StackPanel>
                        <CheckBox Content="да" Height="30"/>
                        <CheckBox Content="нет" Height="26"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource NullBlock}">марка авто</TextBlock>
                    <TextBox></TextBox>
                    <TextBlock Style="{StaticResource NullBlock}">цель езды</TextBlock>
                    <TextBox Style="{StaticResource TextBloka}"></TextBox>
                    <TextBlock>износ шин: </TextBlock>
                    <ProgressBar/>
                    <TextBlock>выберите скорость: </TextBlock>
                    <ComboBox>
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="нейтралка"/>
                    </ComboBox>
                </WrapPanel>
            </WrapPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel4}">
                <TextBlock>недоступные действия</TextBlock>
                <RadioButton IsEnabled="False">открыть капот</RadioButton>
                <RadioButton IsEnabled="False">снять колесо</RadioButton>
            </WrapPanel>
            <WrapPanel Style="{StaticResource FirstWrapPanel5}">
                <TextBlock>режим движения</TextBlock>
                <RadioButton>эко</RadioButton>
                <RadioButton>комфорт</RadioButton>
                <RadioButton>спорт</RadioButton>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
